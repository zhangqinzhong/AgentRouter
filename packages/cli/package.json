{
  "name": "@zhangqinzhong/agentrouter",
  "version": "1.6.7",
  "license": "MIT",
  "description": "Local AgentRouter gateway with CLI and web management UI.",
  "keywords": [
    "claude-code",
    "codex",
    "llm",
    "gateway",
    "router"
  ],
  "main": "dist/main/cli.js",
  "bin": {
    "agentrouter": "dist/main/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "README_zh.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "npm --prefix ../.. run models:update && npm --prefix ../.. run build:assets",
    "prepublishOnly": "npm --prefix ../.. run typecheck",
    "test": "node ../../build/test.mjs cli && node ../../build/run-tests.mjs cli",
    "test:integration": "node ../../build/test.mjs cli --scope integration && node ../../build/run-tests.mjs cli"
  },
  "dependencies": {
    "@the-next-ai/ai-gateway": "^1.0.21",
    "@the-next-ai/bot-gateway-sdk": "^0.1.0",
    "better-sqlite3": "^12.11.1",
    "node-forge": "^1.4.0",
    "undici": "^7.29.0"
  }
}
